# ── Plain English India gateway: environment (copy to .env on the server; never commit .env) ──
# See docs/SETUP.md for where each value comes from.

# Broker (only "upstox" is implemented; zerodha/dhan/fyers/angel are stubs)
BROKER=upstox
# From https://account.upstox.com/developer/apps → your app
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Must match the app's Redirect URL exactly
UPSTOX_REDIRECT_URI=https://gw.example.in/auth/broker/callback
# Optional: X-Algo-Name header, ONLY if you have an exchange-approved algo (not needed under 10 orders/s)
UPSTOX_ALGO_NAME=
# Optional: point orders at the Upstox sandbox (orders only; leave empty for live)
UPSTOX_SANDBOX_TOKEN=

# Gateway sign-in: hash of your passphrase (npm run gateway:hash -- "your long passphrase")
GATEWAY_PASSPHRASE_HASH=
# 32+ random characters: openssl rand -hex 32   (also encrypts the stored broker token)
GATEWAY_JWT_SECRET=
# How long a gateway sign-in lasts
GATEWAY_SESSION_HOURS=12

# Where the frontend lives (GitHub Pages origin, no path) and where to return after broker login
CORS_ORIGINS=https://<your-github-username>.github.io
FRONTEND_URL=https://<your-github-username>.github.io/<repo-name>/

# Real orders are refused unless this is 1. Start with 0 and use paper mode first.
LIVE_TRADING_ENABLED=0

# Risk (the per-trade and daily-loss caps are set in the app, off by default)
RISK_MAX_ORDERS_PER_SEC=5
ALLOWED_SEGMENTS=NSE_FO,BSE_FO,NSE_EQ,BSE_EQ

# Server
HOST=127.0.0.1
PORT=8080
DATA_DIR=./gateway/data
# 1 when behind Caddy/nginx (uses X-Forwarded-For for login throttling)
TRUST_PROXY=1
